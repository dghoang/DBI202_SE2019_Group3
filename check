PROCEDURE 9.1: Calculate students' GPA  

IF OBJECT_ID(sp_CaIcuIateStudentGPA', 'P') IS NOT NULL DROP PROCEDURE sp_CalculateStudentGPA; GO  

# CREATE PROCEDURE sp_CalculateStudentGPA  

@StudentID VARCHAR(10), @SemesterID VARCHAR(15) $=$ NULL  

AS  

BEGIN SET NOCOUNT ON;  

# SELECT  

s.StudentID, p.FirstName $+^{\textsf{11}}+$ ISNULL(p.MiddleName $+~^{1}~^{1}$ ") $^+$ p.LastName AS StudentName, m.MajorName, @SemesterID AS SemesterID, COUNT(DISTINCT sg.SubjectID) AS SubjectCount, AVG(sg.Mark) AS GPA, MIN(sg.Mark) AS MinMark, MAX(sg.Mark) AS MaxMark, SUM(CASE WHEN sg.Mark $>=8.0$ THEN 1 ELSE O END) AS ExcellentSubjects, SUM(CASE WHEN sg.Mark $<5.0$ THEN 1 ELSE 0 END) AS FailedSubjects   
FROM Student s   
INNER JOIN Profile p ON s.ProfilelD $=$ p.ID   
INNER JOIN Major m ON s.MajorID $=$ m.MajorlD   
INNER JOIN StudentGrade sg ON s.StudentID $=$ sg.StudentID   
WHERE s.StudentID ${\bf\Omega}=\@\emptyset$ StudentID AND ( $@$ SemesterID IS NULL OR sg.SemesterID $=$ @SemesterID) AND sg.IsRetake $=0$   
GROUP BY s.StudentID, p.FirstName, p.MiddleName, p.LastName, m.MajorName;  

END;  

