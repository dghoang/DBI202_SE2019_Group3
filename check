# SELECT  

Ig.GoallD,   
Ig.GoalName,   
[g.[Status],   
COUNT(gm.MilestoneID) AS TotalMilestones,   
SUM(CASE WHEN gm.IsCompleted $=1$ THEN 1 ELSE O END) AS CompletedMilestones,  

CAST(SUM(CASE WHEN gm.IsCompleted $=1$ THEN 1 ELSE 0 END) \* 100.0 / COUNT(gm.MilestoneID) AS DECIMAL(5,2)) AS MilestoneCompletionRate,  

MIN(CASE WHEN gm.IsCompleted $=1$ THEN gm.CompletedDate END) AS FirstCompletedDate,  

MAX(CASE WHEN gm.IsCompleted $=1$ THEN gm.CompletedDate END) AS LastCompletedDate  

FROM LearningGoal Ig  

INNER JOIN GoalMilestone gm ON Ig.GoallD $=$ gm.GoallD  

GROUP BY Ig.GoallD, Ig.GoalName, Ig.[Status]  

HAVING COUNT(gm.MilestoneID) > 0  

ORDER BY MilestoneCompletionRate DESC, TotalMilestones DESC;  

